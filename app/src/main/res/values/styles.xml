<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="OverlayThemeOrange" parent="Theme.MJ_Player_TV">
        <item name="colorPrimary">@color/orange</item>
    </style>
    <style name="OverlayThemeYellow" parent="Theme.MJ_Player_TV">
        <item name="colorPrimary">@color/yellow</item>
    </style>
    <style name="OverlayThemeGreen" parent="Theme.MJ_Player_TV">
        <item name="colorPrimary">@color/green</item>
    </style>
    <style name="MySeekbar" parent="android:Widget">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/player_track_normal</item>
        <item name="android:thumb">@drawable/selector_thumb</item>
        <item name="android:focusable">true</item>
        <item name="android:progressTint">?attr/mainPrimaryColor</item>
        <item name="android:paddingLeft">16dip</item>
        <item name="android:paddingRight">16dip</item>
    </style>
    <style name="CustomPopupMenu" parent="android:Widget.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_custom_background</item>
        <item name="android:colorFocusedHighlight">@color/light_mid_grey</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>