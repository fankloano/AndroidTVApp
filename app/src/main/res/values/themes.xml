        <item name="blackwhiteColor">@color/white</item>
        <item name="android:fontFamily">@font/ptsans_regular</item>
    </style>

    <style name="roundedImageViewTopLeft" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
    </style>

    <style name="roundedImageViewBottomRight" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeBottomRight">12dp</item>
    </style>

    <style name="roundedImageViewBottomUpLeft" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">5dp</item>
        <item name="cornerSizeBottomLeft">5dp</item>
