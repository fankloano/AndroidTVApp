<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <objectAnimator
            android:propertyName="cardElevation"
            android:duration="150"
            android:valueTo="24dp"
            android:valueType="floatType"/>
    </item>
    <item>
        <objectAnimator
            android:propertyName="cardElevation"
            android:duration="150"
            android:valueTo="2dp"
            android:valueType="floatType"/>
    </item>
</selector>
