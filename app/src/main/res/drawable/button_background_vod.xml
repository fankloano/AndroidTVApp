<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- Setzen Sie die Hintergrundfarbe für den Default-Status hier ein -->
            <solid android:color="?attr/textColorLight" />
            <stroke android:width="1dp" android:color="?attr/mainPrimaryColor" />
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/textColorLight" />
            <stroke android:width="1dp" android:color="?attr/textMainColor" />
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <!-- Default Status -->
    <item>
        <shape android:shape="rectangle">
            <!-- Setzen Sie die Hintergrundfarbe für den Default-Status hier ein -->
            <solid android:color="?attr/transparentColor" />
            <stroke android:width="1dp" android:color="?attr/textColorDarkGrey" />
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
