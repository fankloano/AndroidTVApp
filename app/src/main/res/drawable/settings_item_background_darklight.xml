<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Selected and Focused state -->
    <item android:state_selected="true" android:state_focused="true">
        <layer-list>
            <!-- Gradient border for selected + focused state -->
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="?attr/mainPrimaryColor" />
                </shape>
            </item>
            <!-- Background for focused state -->
            <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/light_light_grey_L" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected state -->
    <item android:state_selected="true">
        <layer-list>
            <!-- Gradient border for selected state -->
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="?attr/textColorLight" />
                </shape>
            </item>
            <!-- Background for selected state -->
            <item android:left="2dp" android:right="2dp" android:top="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/backgroundDarkDark" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Focused state -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Background for focused state -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/textColorDarkGrey" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/backgroundDarkDark" />
        </shape>
    </item>

</selector>