<!-- res/drawable/item_background.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Gradient border for focused state -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="?attr/textColorLight"
                        android:endColor="?attr/textMainColor"
                        android:angle="0" />

                </shape>
            </item>
            <!-- Blue background -->
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/backgroundDark"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/backgroundDark"/>
        </shape>
    </item>
</selector>
