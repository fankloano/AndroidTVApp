<!-- res/drawable/item_background.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state -->
    <!-- Default state -->

    <item android:state_selected="true" android:state_focused="true">
        <inset
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetRight="0dp"> <!-- Rahmen rechts ausblenden -->
            <shape android:shape="rectangle">
                <stroke
                    android:width="1.5dp"
                    android:color="?attr/mainPrimaryColor" />
                <gradient
                    android:type="linear"
                    android:angle="45"
                    android:startColor="?attr/backgroundDarkLight"
                    android:endColor="?attr/backgroundMain"
                    android:dither="true" />
            </shape>
        </inset>
    </item>

    <item android:state_selected="true">
            <shape android:shape="rectangle">
                <gradient
                    android:type="linear"
                    android:angle="45"
                    android:startColor="?attr/backgroundDarkLight"
                    android:endColor="?attr/backgroundMain"
                    android:dither="true" />
            </shape>
    </item>

    <item android:state_focused="true"
        android:drawable="@drawable/bg_test_focused">
    </item>

    <item>
            <inset
                android:insetLeft="-2dp"
                android:insetTop="-2dp"
                android:insetBottom="-2dp"
                android:insetRight="-2dp"> <!-- Rahmen rechts ausblenden -->
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1.5dp"
                        android:color="?attr/backgroundDarkDark" />
                    <gradient
                        android:type="linear"
                        android:angle="45"
                        android:startColor="?attr/backgroundDark"
                        android:endColor="?attr/backgroundDark"
                        android:dither="true" />
                </shape>
            </inset>
    </item>
</selector>
