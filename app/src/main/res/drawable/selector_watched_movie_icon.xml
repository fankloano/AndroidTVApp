<!-- res/drawable/icon_play_selector.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Zustand: Ausgewählt und Fokussiert -->
    <item android:state_focused="true" android:state_selected="true" android:drawable="@drawable/ic_movie_watched_focused" />

    <!-- Zustand: Ausgewählt -->
    <item android:state_selected="true" android:drawable="@drawable/ic_movie_watched" />
    <!-- Zustand: Fokussiert -->
    <item android:state_focused="true" android:drawable="@drawable/ic_movie_notwatched_focused" />
    <!-- Zustand: Standard -->
    <item android:drawable="@drawable/ic_movie_notwatched" />
</selector>
