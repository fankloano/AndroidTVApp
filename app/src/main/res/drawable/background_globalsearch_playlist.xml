<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fokus Zustand -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Hintergrund (transparent) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
            <!-- Untere Linie -->
            <item android:bottom="1dp" android:top="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent"/>
                    <stroke android:width="1dp" android:color="?attr/mainPrimaryColor"/> <!-- Höhe des Strichs -->
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Selected Zustand -->
    <item android:state_selected="true">
        <layer-list>
            <!-- Hintergrund (transparent) -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
            <!-- Untere Linie -->
            <item android:bottom="1dp" android:top="-2dp" android:left="-2dp" android:right="-2dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/transparent"/>
                    <stroke android:width="1dp" android:color="@color/light_mid_grey"/> <!-- Höhe des Strichs -->
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default Zustand (kein Strich) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/transparent"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

</selector>

