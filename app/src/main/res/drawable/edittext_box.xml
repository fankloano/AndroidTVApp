<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fokussierter Zustand -->
    <item android:state_focused="true">
        <shape>
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/mainPrimaryColor" />
            <solid android:color="?attr/transparentColor" />
        </shape>
    </item>

    <!-- Standardzustand -->
    <item>
        <shape>
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/textColorLight" />
            <solid android:color="?attr/transparentColor" />
        </shape>
    </item>

</selector>
