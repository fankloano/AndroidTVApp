<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <layer-list>
            <!-- Hintergrund -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/backgroundDarkDark" />
                    <corners android:radius="5dp"/>
                </shape>
            </item>

            <!-- Rahmen oben und unten -->
            <item>
                <inset
                    android:insetLeft="-3dp"
                    android:insetTop="-3dp"
                    android:insetBottom="0dp"
                    android:insetRight="-3dp">
                    <shape android:shape="rectangle">
                        <stroke
                            android:width="2dp"
                            android:color="?attr/mainPrimaryColor" />
                        <solid android:color="@color/transparent"/> <!-- Kein Solid, damit Rand sichtbar ist -->
                    </shape>
                </inset>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <!-- Hintergrund -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/backgroundDarkDark" />
                    <corners android:radius="5dp"/>
                </shape>
            </item>

            <!-- Rahmen oben und unten -->
            <item>
                <inset
                    android:insetLeft="-3dp"
                    android:insetTop="-3dp"
                    android:insetBottom="0dp"
                    android:insetRight="-3dp">
                    <shape android:shape="rectangle">
                        <stroke
                            android:width="2dp"
                            android:color="?attr/textColorMidLight" />
                        <solid android:color="@color/transparent"/> <!-- Kein Solid, damit Rand sichtbar ist -->
                    </shape>
                </inset>
            </item>
        </layer-list>
    </item>
    <!-- Fokuszustand -->

    <!-- Default state (kein Rand) -->
    <item>
    <shape android:shape="rectangle">
        <solid android:color="?attr/backgroundDarkDark"/>
        <corners android:radius="5dp"/>
    </shape>
    </item>
</selector>
