<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Background for focused state -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/textColorDarkGrey" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181818" />
        </shape>
    </item>

</selector>