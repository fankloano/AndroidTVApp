<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focused state -->
    <item android:state_focused="true">
        <layer-list>
            <!-- Background for focused state -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="?attr/textColorLight" />
                    <stroke android:width="1dp" android:color="?attr/textMainColor"/>
                    <corners android:radius="9dp"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Default state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/backgroundDark" />
            <corners android:radius="9dp"/>
        </shape>
    </item>

</selector>