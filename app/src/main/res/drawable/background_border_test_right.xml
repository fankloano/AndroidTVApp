<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="-4dp"
    android:insetBottom="-4dp">
    <shape android:shape="rectangle">
        <stroke
            android:width="1.5dp"
            android:color="@color/light_light_grey_L" />
        <gradient
            android:type="linear"
            android:angle="45"
            android:startColor="?attr/backgroundDark"
            android:endColor="?attr/backgroundDarkDark"
            android:dither="true" />
    </shape>
</inset>
