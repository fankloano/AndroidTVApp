<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <!-- background -->
            <solid android:color="?attr/backgroundDark" />
            <!-- border -->
            <stroke android:width="1dp" android:color="?attr/mainPrimaryColor" />

        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <!-- background -->
            <solid android:color="?attr/backgroundLight" />

        </shape>
    </item>
</selector>
