<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Schatteneffekt von unten nach oben -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:startColor="?attr/backgroundDarkDark"
                android:centerColor="?attr/transparentColor"
                android:endColor="?attr/transparentColor"
                android:type="linear" />
        </shape>
    </item>

    <!-- Schatteneffekt von links nach rechts -->
    <item>
        <shape>
            <gradient
                android:angle="0"
                android:startColor="?attr/backgroundDarkDark"
                android:centerColor="?attr/transparentColor"
                android:endColor="?attr/transparentColor"
                android:type="linear" />
        </shape>
    </item>

</layer-list>
