<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hintergrund mit abgerundeten Ecken -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181818" />
            <corners
                android:topLeftRadius="8dp" />
        </shape>
    </item>

    <!-- Rahmen für die oberen, unteren und linken Seiten -->
    <item>
        <inset
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetBottom="-4dp"
            android:insetRight="-4dp"> <!-- Rahmen rechts ausblenden -->
            <shape android:shape="rectangle">
                <stroke
                    android:width="3dp"
                    android:color="?attr/backgroundMain" />
                <solid android:color="@android:color/transparent" />
                <corners
                    android:topLeftRadius="8dp" /> <!-- Rechte obere Ecke abrunden -->
            </shape>
        </inset>
    </item>
</layer-list>


