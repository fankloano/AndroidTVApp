<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Wenn fokussiert: Weißer Streifen -->
    <item android:state_focused="true">
        <layer-list>
            <item android:width="3dp" android:gravity="end">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="45"
                        android:startColor="?attr/textColorMidLight"
                        android:centerColor="?attr/textMainColor"
                        android:endColor="?attr/textColorMidLight"
                        android:dither="true" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_selected="true">
        <layer-list>
            <item android:width="3dp" android:gravity="end">
                <shape android:shape="rectangle">
                    <gradient
                        android:type="linear"
                        android:angle="45"
                        android:startColor="?attr/textColorMidLight"
                        android:centerColor="?attr/textColorLight"
                        android:endColor="?attr/textColorMidLight"
                        android:dither="true" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Standard: Transparent -->
    <item>
        <color android:color="@android:color/transparent" />
    </item>

</selector>
