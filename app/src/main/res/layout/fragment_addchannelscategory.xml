<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundDarkDark"
    android:foreground="@drawable/background_border_settings_left">

    <TextView
        android:id="@+id/title_setting"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/backgroundDarkDark"
        android:gravity="start|center_vertical"
        android:text="Select Category bitte:"
        android:textColor="?attr/textMainColor"
        android:textSize="16sp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/relLayoutButtons"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:weightSum="1"
        android:background="?attr/backgroundDark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_setting">

    <TextView
        android:id="@+id/btn_selectAll"
        android:layout_width="0dp"
        android:layout_weight="0.50"
        android:layout_height="40dp"
        android:background="@drawable/settings_item_background"
        android:focusable="true"
        android:layout_margin="2dp"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:nextFocusLeft="@id/btn_selectAll"
        android:nextFocusRight="@id/btn_deselectAll"
        android:nextFocusUp="@id/btn_selectAll"
        android:nextFocusDown="@id/rv_layout_TvCategory"
        android:text="Show All Playlist Categories"
        android:textColor="@drawable/focused_selected_mainmenu"
        android:textSize="12sp"
        app:layout_constraintWidth_percent="0.49" />

    <TextView
        android:id="@+id/btn_deselectAll"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="0.50"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:layout_margin="2dp"
        android:nextFocusLeft="@id/btn_selectAll"
        android:nextFocusRight="@id/btn_deselectAll"
        android:nextFocusUp="@id/btn_deselectAll"
        android:nextFocusDown="@id/rv_layout_TvCategory"
        android:textStyle=""
        android:text="Show Only Selected Categories"
        android:background="@drawable/settings_item_background"
        android:textColor="@drawable/focused_selected_mainmenu"
        android:textSize="12sp" />

    </LinearLayout>

    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/rv_layout_TvCategory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingTop="2dp"
        android:paddingBottom="5dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        tools:listitem="@layout/rv_item_addchannels_playlists"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/relLayoutButtons"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>