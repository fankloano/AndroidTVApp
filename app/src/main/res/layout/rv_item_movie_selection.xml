<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    android:gravity="center_vertical"
    android:background="?attr/backgroundDarkDark"
    android:padding="3dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusableInTouchMode="true"
        android:focusable="true"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:id="@+id/relLayout_movie_selector"
        android:background="@drawable/settings_item_background_dark">


        <CheckBox
            android:id="@+id/cb_vodSelection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:scaleX="0.7"
            android:scaleY="0.7"
            android:layout_marginStart="5dp"
            android:layout_alignParentStart="true"
            android:buttonTint="@color/selector_checkbox_add_channels"
            tools:ignore="TouchTargetSizeCheck" />

        <TextView
            android:id="@+id/tv_selection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="5dp"
            tools:text="TEST DAS MAL"
            android:gravity="center_vertical"
            android:textColor="?attr/textMainColor"
            android:textSize="15sp"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:singleLine="true"
            android:layout_marginEnd="36dp"
            android:scrollHorizontally="true"
            android:layout_toEndOf="@id/cb_vodSelection"
            android:layout_centerVertical="true" />

        <ImageView
            android:id="@+id/iv_support"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="8dp"
            android:visibility="invisible"
            android:src="@drawable/ic_playlistupdate_error"
            android:layout_centerVertical="true"/>

    </RelativeLayout>

</RelativeLayout>