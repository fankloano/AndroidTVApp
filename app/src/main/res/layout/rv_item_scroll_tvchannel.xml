<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relLayout_scroll_tvchannel"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:gravity="center_vertical"
    android:focusable="true"
    android:background="@drawable/selector_scroll_tvchannel_background"
    android:focusableInTouchMode="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


          <com.google.android.material.imageview.ShapeableImageView
              android:layout_width="0dp"
              android:layout_height="47dp"
              android:id="@+id/iv_channel_logo"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              app:layout_constraintBottom_toBottomOf="parent"
              app:layout_constraintWidth_percent="0.2"
              android:layout_marginTop="1.5dp"
              android:layout_marginBottom="1.5dp"
              android:layout_marginStart="10dp"
              android:paddingStart="2dp"
              app:shapeAppearanceOverlay="@style/roundedImageViewBottomUpLeft"
              tools:src="@drawable/skybundesliga"
              android:duplicateParentState="true"
              android:scaleType="centerInside"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_marginStart="20dp"
              android:layout_marginEnd="10dp"
              app:layout_constraintStart_toEndOf="@id/iv_channel_logo"
              app:layout_constraintEnd_toEndOf="parent"
              android:orientation="vertical">

              <TextView
                  android:id="@+id/tv_channelname"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  tools:text="DE: SKY CINEMA HIGHLIGHT 4K FHD"
                  android:textColor="@drawable/selector_textview_scroll_tvchannels"
                  android:textSize="12sp"
                  android:maxLines="1"
                  android:scrollHorizontally="true"
                  android:ellipsize="end"
                  android:layout_marginTop="2dp"
                  app:layout_constraintTop_toTopOf="parent"
                  app:layout_constraintStart_toStartOf="parent"/>

               <LinearLayout
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal"
                   android:layout_marginTop="3dp">

                  <TextView
                      android:id="@+id/tv_StartTime"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      tools:text="08:20"
                      android:textColor="#A6A5A5"
                      android:textSize="11sp"/>

                 <TextView
                     android:id="@+id/tv_EndTime"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     tools:text=" - 08:20"
                     android:textColor="#A6A5A5"
                     android:textSize="11sp" />

                   <TextView
                       android:id="@+id/tv_Program"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content"
                       tools:text="Es war einmal in Amerika"
                       android:textColor="@drawable/selector_textview_scroll_tvchannels"
                       android:textSize="11sp"
                       android:layout_marginStart="10dp"
                       android:layout_marginEnd="10dp"
                       android:singleLine="true"
                       android:ellipsize="marquee"
                       android:scrollHorizontally="true"
                       android:marqueeRepeatLimit="marquee_forever" />

               </LinearLayout>

              <ProgressBar
                  android:id="@+id/progressBar"
                  style="?android:attr/progressBarStyleHorizontal"
                  android:layout_width="match_parent"
                  android:layout_height="1dp"
                  android:padding="1dp"
                  android:layout_marginEnd="5dp"
                  android:progress="50"
                  android:max="100"
                  android:layout_marginTop="5dp"
                  android:progressTint="@color/progressbar_tint"
                  android:layout_gravity="bottom"/>

          </LinearLayout>

    <View
        android:id="@+id/overlay_full"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@drawable/background_overlay_scroll_tvchannels"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>