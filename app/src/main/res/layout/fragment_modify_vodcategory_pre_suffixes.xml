<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_gravity="center"
    android:background="?attr/backgroundDarkDark"
    android:foreground="@drawable/background_border_settings_left">

    <RelativeLayout
        android:id="@+id/relLayout_modify_channel_names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/backgroundDark">

        <TextView
            android:id="@+id/title_setting"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="if category name = US: Crime\nto remove US: add US: as prefix"
            android:textSize="16sp"
            android:lines="1"
            android:gravity="center"
            android:textColor="?attr/textColorLight"/>
    </RelativeLayout>


    <TextView
        android:id="@+id/tv_prefix"
        android:layout_marginTop="15dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prefixes to remove:"
        android:textColor="?attr/mainPrimaryColor"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/info_prefix"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="if category name = US: Crime\nto remove US: add US: as prefix"
        android:textColor="?attr/textColorLight"
        android:lines="2"
        android:textSize="12sp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp" />

    <EditText
        android:layout_marginTop="10dp"
        android:id="@+id/edit_text_prefixes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/textMainColor"
        android:background="@drawable/edittext_box"
        android:textColorHint="@color/background_light"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:padding="6dp"
        android:textSize="13sp"
        android:maxLines="1"
        android:nextFocusUp="@id/edit_text_prefixes"
        android:nextFocusLeft="@id/edit_text_prefixes"
        android:nextFocusRight="@id/edit_text_prefixes"/>

    <TextView
        android:id="@+id/tv_suffix"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suffixes to remove:"
        android:layout_marginTop="20dp"
        android:textColor="?attr/mainPrimaryColor"
        android:textSize="15sp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp" />

    <TextView
        android:id="@+id/info_suffix"
        android:layout_marginTop="5dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="if category name = Crime XYZ \nto remove XYZ add XYZ as suffix"
        android:textColor="?attr/textColorLight"
        android:textSize="12sp"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp" />

    <EditText
        android:layout_marginTop="10dp"
        android:id="@+id/edit_text_suffixes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Prefixes (comma separated)"
        android:textColor="@color/white"
        android:background="@drawable/edittext_box"
        android:textColorHint="@color/background_light"
        android:layout_marginLeft="14dp"
        android:layout_marginRight="14dp"
        android:privateImeOptions="horizontalAlignment=left"
        android:maxLines="1"
        android:padding="6dp"
        android:textSize="13sp"
        android:nextFocusLeft="@id/edit_text_suffixes"
        android:nextFocusRight="@id/edit_text_suffixes"
        android:nextFocusDown="@id/btn_savePrefixesSuffixes"/>


    <TextView
        android:id="@+id/title_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text= "Use , (comma) to separate"
        android:textSize="14sp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="14dp"
        android:lines="3"
        android:gravity="center_vertical"
        android:textColor="?attr/textColorLight"/>

    <Button
        android:id="@+id/btn_savePrefixesSuffixes"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_gravity="center_horizontal"
        android:text="@string/save"
        android:background="@drawable/selector_button_background"
        android:textColor="@drawable/focused_selected_textview"
        android:textSize="16dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/btn_savePrefixesSuffixes"
        android:nextFocusRight="@id/btn_savePrefixesSuffixes" />

</LinearLayout>