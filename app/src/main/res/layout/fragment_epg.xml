<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/epg_root_layout">

    <com.example.mj_player_tv.ui.epg.EpgTimeLineRow
        android:id="@+id/timeline_header_view"
        android:layout_width="0dp"
        android:layout_height="35dp"
        android:orientation="horizontal"
        android:layout_marginStart="180dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        tools:listitem="@layout/vg_item_epg_timeline"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.example.mj_player_tv.ui.epg.CustomEpgVerticalGridView
        android:id="@+id/epg_grid_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        tools:listitem="@layout/vg_item_epg_row"
        app:layout_constraintTop_toBottomOf="@id/timeline_header_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <View
        android:id="@+id/current_time_indicator"
        android:layout_width="1.5dp"
        android:layout_height="0dp"
        android:focusable="false"
        app:layout_constraintTop_toTopOf="@id/epg_grid_view"
        app:layout_constraintBottom_toBottomOf="@id/epg_grid_view"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="180dp"
        android:translationX="0dp" />

</androidx.constraintlayout.widget.ConstraintLayout>