<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/const_tv"
    android:background="?attr/backgroundDark"
    android:descendantFocusability="afterDescendants"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <LinearLayout
        android:id="@+id/linLayout_tvAccounts_menu"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="1dp"
        android:background="@drawable/background_border_test_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"
        tools:listitem="@layout/rv_item_activated_accounts">

        <TextView
            android:id="@+id/tv_allAccounts"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:text="TV ACCOUNTS"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textSize="15sp"
            android:textColor="?attr/textMainColor" />

        <com.rubensousa.dpadrecyclerview.DpadRecyclerView
            android:id="@+id/rv_layout_tvAccounts_menu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="1dp"
            android:paddingTop="2dp"
            android:layout_marginTop="1dp"
            android:orientation="vertical"
            tools:listitem="@layout/rv_item_activated_accounts" />

    </LinearLayout>

    <View
        android:id="@+id/divider_account_category"
        android:layout_width="1dp"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/linLayout_tvAccounts_menu"
        app:layout_constraintEnd_toEndOf="@id/linLayout_tvAccounts_menu"
        android:background="@color/background_light"/>

    <RelativeLayout
        android:id="@+id/relLayout_tvchannels"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toEndOf="@id/linLayout_tvAccounts_menu"
        app:layout_constraintWidth_percent="0.52">

        <TextView
            android:id="@+id/tv_selectedTvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/textMainColor"
            android:textSize="13sp"
            tools:text="DE: SKY CINEMA FULL HDDHD"
            android:maxWidth="300dp"
            android:layout_marginStart="16dp"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/tv_loadEpg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/mainPrimaryColorDark"
            android:text="..check epg.."
            android:layout_marginTop="1dp"
            android:visibility="gone"
            android:textSize="12sp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/tv_actualChNr"/>

        <TextView
            android:id="@+id/tv_actualChNr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/textColorLight"
            tools:text="46 "
            android:layout_marginTop="1dp"
            android:visibility="invisible"
            android:textSize="12sp"
            android:layout_toStartOf="@id/tv_catChannelSize"/>

        <TextView
            android:id="@+id/tv_catChannelSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/textColorLight"
            tools:text="/ 46"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="1dp"
            android:visibility="invisible"
            android:textSize="12sp"
            android:layout_alignParentEnd="true"/>

        <com.rubensousa.dpadrecyclerview.DpadRecyclerView
            android:id="@+id/rv_layout_TvChannels"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/tv_selectedTvCategory"
            android:layout_marginTop="-1dp"
            android:background="?attr/backgroundDark"
            android:descendantFocusability="afterDescendants"
            android:nextFocusRight="@id/tv_showFullEpg"
            android:orientation="vertical"
            tools:listitem="@layout/rv_item_tvchannels" />

    </RelativeLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_ChannelOptions"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="?attr/backgroundSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.30"
        tools:listitem="@layout/rv_item_tvchannels"/>

    <TextView
        android:id="@+id/tv_noTvCategories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No enabled tv categories!\n Go to playlist settings!"
        app:layout_constraintStart_toStartOf="@id/linLayout_tvAccounts_menu"
        app:layout_constraintTop_toTopOf="parent"
        android:maxLines="3"
        android:gravity="center_horizontal"
        app:layout_constraintEnd_toEndOf="@id/linLayout_tvAccounts_menu"
        android:layout_marginTop="50dp"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_noTvAccounts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_active_accounts"
        app:layout_constraintStart_toStartOf="parent"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="@id/linLayout_tvAccounts_menu"
        android:layout_marginTop="50dp"/>

    <FrameLayout
        android:id="@+id/videoView_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/backgroundDark"
        android:descendantFocusability="afterDescendants"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintHeight_percent="0.48"
        app:layout_constraintStart_toEndOf="@id/relLayout_tvchannels">

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoView"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/backgroundDark"
            android:visibility="invisible"
            app:resize_mode="fit">

            <TextView
                android:id="@+id/tv_tvchannelname"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="5dp"
                android:maxLines="1"
                android:textColor="?attr/textColorLight"
                android:textSize="12sp"
                android:visibility="invisible"
                app:layout_constraintWidth_percent="0.5"
                tools:text="DE | SKY BUNDESLIGA 1 FHD uswdadsaasda" />

            <TextView
                android:id="@+id/playingError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                android:textColor="?attr/textMainColor"
                android:textSize="12sp"
                android:visibility="invisible"
                tools:text="Error code: 462 - cant play stream" />

            <ProgressBar
                android:id="@+id/player_progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="invisible" />

        </androidx.media3.ui.PlayerView>

    </FrameLayout>

    <TextView
        android:id="@+id/fullScreen_playingError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/textMainColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:padding="10dp"
        tools:text="Error code: 462 - cant play stream"
        android:visibility="invisible"
        android:textStyle="bold"
        android:textSize="15sp"/>

    <ProgressBar
        android:id="@+id/fullScreen_ProgressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:visibility="invisible"/>

    <RelativeLayout
        android:id="@+id/relLayout_channel_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="@id/videoView_preview"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="7dp">


        <LinearLayout
            android:id="@+id/channel_metdata"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_fps"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="invisible"
                android:textStyle="bold"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:layout_margin="3dp"
                tools:text="FPS: 25"/>

            <TextView
                android:id="@+id/tv_channelQuality"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:visibility="invisible"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:layout_margin="3dp"
                tools:text="1280x7210"/>

            <TextView
                android:id="@+id/tv_audio"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="invisible"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:layout_margin="3dp"
                tools:text="Stereo"/>

        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relLayout_epg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="4dp"
        android:visibility="invisible"
        android:background="@drawable/background_rounded_rightdown_gradient_fullepg_detailepg"
        android:padding="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.50"
        app:layout_constraintStart_toEndOf="@id/relLayout_tvchannels"
        app:layout_constraintWidth_percent="0.47">

        <RelativeLayout
            android:id="@+id/relLayout_currentProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/epgpreview_divider"
            android:layout_below="@id/tv_epg_tvchannelname">

            <TextView
                android:id="@+id/tv_currentStartTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:fontFamily="sans-serif-smallcaps"
                android:paddingStart="8dp"
                android:textColor="#CBFFFFFF"
                android:textSize="13sp"
                android:typeface="monospace"
                tools:text="08:20" />

            <TextView
                android:id="@+id/tv_currentEndTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/tv_currentStartTime"
                android:fontFamily="sans-serif-smallcaps"
                android:paddingEnd="8dp"
                android:textColor="#CBFFFFFF"
                android:textSize="13sp"
                android:typeface="monospace"
                tools:text=" - 08:20" />

            <TextView
                android:id="@+id/tv_currentProgram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_currentStartTime"
                android:ellipsize="marquee"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:singleLine="true"
                android:textColor="?attr/textMainColor"
                android:textSize="14sp"
                tools:text="Es war einmal in Amerika" />

            <TextView
                android:id="@+id/tv_currentSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_currentProgram"
                android:ellipsize="marquee"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:singleLine="true"
                android:textColor="?attr/textColorLight"
                android:textSize="13sp"
                android:textStyle=""
                tools:text="Folge 5, Staffel 10 - Es war einmal ein Mann" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_currentSubtitle"
                android:layout_marginStart="3dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="3dp"
                android:layout_marginBottom="3dp"
                android:ellipsize="end"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:maxLines="5"
                android:padding="5dp"
                android:textColor="?attr/textColorLight"
                android:textSize="13sp"
                app:layout_constraintWidth_percent="0.46"
                tools:text="In drei ineinander verwobenen Zeitabschnitten (1922, 1933 und 1968) wird die Geschichte einer Bande in New York City erzählt. Sie kommt während der Alkoholprohibition in den USA zu schnellem Reichtum und viel Macht, indem sie Schutzgeld erpresst, Konkurrenten gewaltsam aus dem Weg räumt und Alkohol schmuggelt." />

            <View
                android:id="@+id/border_animated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignStart="@id/tv_description"
                android:layout_alignTop="@id/tv_description"
                android:layout_alignEnd="@id/tv_description"
                android:layout_alignBottom="@id/tv_description"
                android:background="@drawable/background_border_grey_rounded"
                android:padding="2dp"
                android:visibility="invisible"
                app:layout_constraintWidth_percent="0.46" />

        </RelativeLayout>

        <View
            android:id="@+id/epgpreview_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_above="@id/relLayout_shortEpg"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="80dp"
            android:layout_marginBottom="2dp"
            android:background="@color/light_light_grey"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/relLayout_shortEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="5dp">

            <LinearLayout
                android:id="@+id/shortEpg_NextInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tv_nextStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-smallcaps"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:textColor="?attr/textColorLight"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    tools:text="08:10" />

                <TextView
                    android:id="@+id/tv_nextEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-smallcaps"
                    android:paddingTop="2dp"
                    android:textColor="?attr/textColorLight"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    tools:text=" - 08:20" />

                <LinearLayout
                    android:id="@+id/shortEpg_NextProgram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_nextProgram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:paddingStart="8dp"
                        android:singleLine="true"
                        android:textColor="#E6E6E6"
                        android:textSize="13sp"
                        tools:text="Es war einmal in Amerika" />

                    <TextView
                        android:id="@+id/tv_nextsubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:paddingStart="8dp"
                        android:singleLine="true"
                        android:textColor="#A6A5A5"
                        android:textSize="12sp"
                        tools:text="Folge 5, Staffel 10 - Es war einmal ein Mann" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/shortEpg_OverNextInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/shortEpg_NextInfo"
                android:layout_marginTop="5dp">

                <TextView
                    android:id="@+id/tv_overnextStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-smallcaps"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:textColor="?attr/textColorLight"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    tools:text="08:20" />

                <TextView
                    android:id="@+id/tv_overnextEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-smallcaps"
                    android:paddingTop="2dp"
                    android:textColor="?attr/textColorLight"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    tools:text=" - 08:20" />

                <LinearLayout
                    android:id="@+id/shortEpg_OverNextProgram"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_overnextProgram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:paddingStart="8dp"
                        android:singleLine="true"
                        android:textColor="#E6E6E6"
                        android:textSize="13sp"
                        tools:text="Es war einmal in Amerika" />

                    <TextView
                        android:id="@+id/tv_overnextsubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:paddingStart="8dp"
                        android:singleLine="true"
                        android:textColor="#A6A5A5"
                        android:textSize="12sp"
                        tools:text="Folge 5, Staffel 10 - Es war einmal ein Mann" />

                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_noepgavailable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/no_epg_available"
            android:textColor="?attr/textColorLight"
            android:textSize="20sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tv_epg_tvchannelname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="5dp"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:padding="6dp"
            android:textColor="?attr/textMainColor"
            android:textSize="13sp"
            tools:text="DE | SKY BUNDESLIGA 1 FHD uswdadsaasda" />

        <Button
            android:id="@+id/tv_showFullEpg"
            android:layout_width="wrap_content"
            android:layout_height="35dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/selector_button_background"
            android:gravity="center"
            android:nextFocusLeft="@id/rv_layout_TvChannels"
            android:nextFocusRight="@id/tv_showFullEpg"
            android:nextFocusUp="@id/tv_showFullEpg"
            android:nextFocusDown="@id/tv_showFullEpg"
            android:text="EPG"
            android:textColor="@drawable/focused_selected_mainmenu"
            android:textSize="15sp" />

    </RelativeLayout>


    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/rv_preview_FullEpg"
        android:layout_height="0dp"
        android:layout_width="0dp"
        android:visibility="invisible"
        android:background="?attr/backgroundDark"
        app:layout_constraintStart_toEndOf="@id/relLayout_tvchannels"
        app:layout_constraintWidth_percent="0.47"
        app:layout_constraintHeight_percent="0.52"
        android:layout_marginTop="5dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/rv_layout_FullEpg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/rv_item_tvchannels"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/relLayout_chOrder_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/background_chorder_infos"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/relLayout_tvchannels"
        app:layout_constraintWidth_percent="0.48">

        <!-- TextView 1: Links -->
        <TextView
            android:id="@+id/tv_orderChInfo_UpDown"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_marginTop="2dp"
            android:layout_marginStart="5dp"
            app:layout_constraintWidth_percent="0.33"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="@string/up_down_move_channel" />

        <!-- TextView 2: Mitte -->
        <TextView
            android:id="@+id/tv_orderChInfo_OK"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            app:layout_constraintWidth_percent="0.33"
            app:layout_constraintStart_toEndOf="@id/tv_orderChInfo_UpDown"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="OK: Select Channel" />

        <!-- TextView 3: Rechts -->
        <TextView
            android:id="@+id/tv_orderChInfo_Return"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@color/white"
            app:layout_constraintWidth_percent="0.33"
            android:layout_marginEnd="5dp"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toEndOf="@id/tv_orderChInfo_OK"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Back: Change Channel" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/hud_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/background_hud_fullscreen"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.40"
        tools:layout_editor_absoluteX="0dp">

        <LinearLayout
            android:id="@+id/relLayout_seekbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="1"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/relLayout_hudchannellogo"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_currentTimeCatchup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="0.05"
                android:paddingStart="8dp"
                android:textColor="@color/light_grey"
                tools:text="00:00" />

            <androidx.media3.ui.DefaultTimeBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="5dp"
                android:layout_weight="0.9"
                android:focusable="true"
                android:focusableInTouchMode="true"
                app:buffered_color="#736E6E"
                app:scrubber_color="@color/light_blue_darker"
                app:played_color="@color/light_blue"
                app:unplayed_color="@color/light_mid_grey"
                app:scrubber_enabled_size="12dp"
                app:scrubber_dragged_size="16dp"
                app:scrubber_disabled_size="6dp"
                app:bar_height="2.5dp" />

            <TextView
                android:id="@+id/tv_totalTimeCatchup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.05"
                android:textColor="@color/light_grey"
                tools:text="00:00" />

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/relLayout_hudchannellogo"
            android:layout_width="100dp"
            android:layout_height="120dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toTopOf="@id/const_programinfo"
            app:layout_constraintHeight_percent="0.45"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:id="@+id/fullscreen_channelprevious"
                android:layout_width="110dp"
                android:layout_height="15dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:rotation="180"
                android:src="@drawable/ic_arrow_down" />

            <ImageView
                android:id="@+id/fullscreen_channelnext"
                android:layout_width="110dp"
                android:layout_height="15dp"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:src="@drawable/ic_arrow_down" />

            <ImageView
                android:id="@+id/hud_channel_logo"
                android:layout_width="100dp"
                android:layout_height="90dp"
                android:layout_centerHorizontal="true"
                android:layout_centerVertical="true"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:padding="8dp"
                android:scaleType="fitCenter"
                tools:src="@drawable/skybundesliga" />

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_hud_channelname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/background_hud_chlogo_rounded"
            android:ellipsize="marquee"
            android:padding="3dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:layout_constraintBottom_toBottomOf="@id/relLayout_hudchannellogo"
            app:layout_constraintStart_toEndOf="@id/relLayout_hudchannellogo"
            tools:text="DE | SKY CINEMA Bundesliga 1 FHD (play only live events)" />

        <!-- Channel-Quality-Info oben -->
        <LinearLayout
            android:id="@+id/channel_quality_info_fullscreen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_hud_channelname"
            android:layout_marginStart="8dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/tv_hud_channelname"
            app:layout_constraintStart_toEndOf="@id/relLayout_hudchannellogo">

            <TextView
                android:id="@+id/tv_fullscreen_channelQuality"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.8"
                tools:text="1280x7210" />

            <TextView
                android:id="@+id/tv_fullscreen_fps"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.8"
                tools:text="FPS: 25" />

            <TextView
                android:id="@+id/tv_fullscreen_audio"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:alpha="0.8"
                tools:text="5.1" />
        </LinearLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/const_programinfo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.37"
            app:layout_constraintStart_toStartOf="parent">

            <RelativeLayout
                android:id="@+id/relLayout_hud_currentprogram"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:padding="5dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.50">

                <LinearLayout
                    android:id="@+id/linLayout_hud_currentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_hud_currentProgramTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:textSize="14sp"
                        tools:text="10:30 - 15:00" />

                    <ProgressBar
                        android:id="@+id/hudprogressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="120dp"
                        android:layout_height="5dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="15dp"
                        android:padding="1dp"
                        android:progress="20"
                        android:progressTint="?attr/mainPrimaryColor" />

                    <TextView
                        android:id="@+id/tv_remainingTimeCurrentProgram"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="15dp"
                        android:textColor="?attr/textColorLight"
                        android:textSize="12sp"
                        tools:text="1h 25min remaining.." />

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_hud_currenProgramName"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_below="@id/linLayout_hud_currentTime"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="26dp"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    tools:text="Der Herr der Ringe: Die Rückkehr des Königssad asdasdadasdsadasdadasdsa" />

                <TextView
                    android:id="@+id/tv_hud_currenProgramSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_below="@id/tv_hud_currenProgramName"
                    android:layout_centerVertical="true"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="26dp"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:textColor="@color/light_grey"
                    android:textSize="15sp"
                    tools:text="Die Rückkehr des Königsadadasdadadadadadasdadadadasdsdadasdasdadadasdasdas" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/linLayout_hud_nextProgram"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:padding="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.42">

                <LinearLayout
                    android:id="@+id/linLayout_hudnextProgramTime"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/fullscreen_channelpreviousepg"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="-5dp"
                        android:rotation="90"
                        android:src="@drawable/ic_arrow_down"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/tv_hud_nextProgramTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:textSize="14sp"
                        tools:text="10:30 - 15:00" />

                    <ImageView
                        android:id="@+id/fullscreen_channelnextepg"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:rotation="270"
                        android:src="@drawable/ic_arrow_down" />

                    <TextView
                        android:id="@+id/tv_hud_programinfo"
                        android:layout_width="wrap_content"
                        android:layout_height="25dp"
                        android:layout_marginStart="15dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/light_grey"
                        android:textSize="14sp"
                        tools:text="Upcoming Program" />


                </LinearLayout>

                <TextView
                    android:id="@+id/tv_hud_nextProgramName"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_below="@id/linLayout_hudnextProgramTime"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="26dp"
                    android:ellipsize="marquee"
                    android:gravity="bottom"
                    android:singleLine="true"
                    android:textSize="16sp"
                    tools:text="Der Herr der Ringe: Die Rückkehr des Königssad asdasdadasdsadasdadasdsa" />

                <TextView
                    android:id="@+id/tv_hud_nextProgramSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_below="@id/tv_hud_nextProgramName"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="26dp"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:textColor="@color/light_mid_grey"
                    android:textSize="14sp"
                    tools:text="Die Rückkehr des Königsadadasdadadadadadasdadadadasdsdadasdasdadadasdasdas" />

            </RelativeLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/tv_error_channel_play"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:gravity="center"
        tools:text="ERROR 404: Du kannst nichts abspielen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:textSize="14sp"
        android:visibility="gone"
        android:background="@drawable/background_tv_error"
        app:layout_constraintWidth_percent="0.47" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_AssignChannelToEpg"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:background="?attr/backgroundSettings"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.40"
        tools:listitem="@layout/rv_item_tvchannels"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fullscreen_channelchange"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.40"
        tools:listitem="@layout/rv_item_tvchannels"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fullscreen_epgInfo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.50"
        app:layout_constraintWidth_percent="0.40"/>

    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/rv_layout_scrollChannels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:nextFocusRight="@id/rv_layout_scrollChannels"
        android:nextFocusLeft="@id/rv_layout_scrollChannels"
        android:orientation="vertical"
        android:background="@drawable/background_scrolltvchannel_recyclerview"
        android:visibility="gone"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintTop_toTopOf="@id/videoView_preview"
        app:layout_constraintBottom_toBottomOf="@id/videoView_preview"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/rv_item_scroll_tvchannel" />

    <!-- Obere Schatten-Overlay -->
    <View
        android:id="@+id/shadow_top"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/shadow_top"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/rv_layout_scrollChannels"
        app:layout_constraintStart_toStartOf="@id/rv_layout_scrollChannels"
        app:layout_constraintEnd_toEndOf="@id/rv_layout_scrollChannels" />

    <!-- Untere Schatten-Overlay -->
    <View
        android:id="@+id/shadow_bottom"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/shadow_bottom"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rv_layout_scrollChannels"
        app:layout_constraintStart_toStartOf="@id/rv_layout_scrollChannels"
        app:layout_constraintEnd_toEndOf="@id/rv_layout_scrollChannels" />


</androidx.constraintlayout.widget.ConstraintLayout>