<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/videoView_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/backgroundDark"
        android:descendantFocusability="afterDescendants">

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoView"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/backgroundDark"
            android:visibility="invisible"
            app:resize_mode="fit">

            <TextView
                android:id="@+id/tv_tvchannelname"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="5dp"
                android:maxLines="1"
                android:textColor="?attr/textColorLight"
                android:textSize="12sp"
                android:visibility="invisible"
                app:layout_constraintWidth_percent="0.5"
                tools:text="DE | SKY BUNDESLIGA 1 FHD uswdadsaasda" />

            <TextView
                android:id="@+id/playingError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                android:textColor="?attr/textMainColor"
                android:textSize="12sp"
                android:visibility="invisible"
                tools:text="Error code: 462 - cant play stream" />

            <ProgressBar
                android:id="@+id/player_progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="invisible" />

        </androidx.media3.ui.PlayerView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>