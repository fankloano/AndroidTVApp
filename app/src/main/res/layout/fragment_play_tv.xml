<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <FrameLayout
        android:id="@+id/videoView_preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/backgroundDark"
        android:descendantFocusability="afterDescendants">

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoView"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/backgroundDark"
            app:resize_mode="fit">

            <TextView
                android:id="@+id/tv_tvchannelname"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="5dp"
                android:maxLines="1"
                android:textColor="?attr/textColorLight"
                android:textSize="12sp"
                android:visibility="invisible"
                app:layout_constraintWidth_percent="0.5"
                tools:text="DE | SKY BUNDESLIGA 1 FHD uswdadsaasda" />

            <TextView
                android:id="@+id/tv_playingError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="25dp"
                android:layout_marginEnd="25dp"
                android:textColor="?attr/textMainColor"
                android:textSize="14sp"
                android:visibility="invisible"
                tools:text="Error code: 462 - cant play stream" />

            <ProgressBar
                android:id="@+id/player_progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="invisible" />

        </androidx.media3.ui.PlayerView>

    </FrameLayout>

    <RelativeLayout
        android:id="@+id/relLayout_channel_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="@id/videoView_preview"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="7dp">


        <LinearLayout
            android:id="@+id/channel_metdata"
            android:layout_width="wrap_content"
            android:layout_height="25dp"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_fps"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:visibility="invisible"
                android:textStyle="bold"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:layout_margin="3dp"
                tools:text="FPS: 25"/>

            <TextView
                android:id="@+id/tv_channelQuality"
                android:layout_width="60dp"
                android:layout_height="match_parent"
                android:visibility="invisible"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:layout_margin="3dp"
                tools:text="1280x7210"/>

            <TextView
                android:id="@+id/tv_audio"
                android:layout_width="40dp"
                android:layout_height="match_parent"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:visibility="invisible"
                android:background="@drawable/background_hud_chlogo_rounded"
                android:layout_margin="3dp"
                tools:text="Stereo"/>

        </LinearLayout>

    </RelativeLayout>

    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/rv_layout_scrollChannels"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:nextFocusRight="@id/rv_layout_scrollChannels"
        android:nextFocusLeft="@id/rv_layout_scrollChannels"
        android:orientation="vertical"
        android:background="@drawable/background_scrolltvchannel_recyclerview"
        android:visibility="gone"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintWidth_percent="0.32"
        app:layout_constraintTop_toTopOf="@id/videoView_preview"
        app:layout_constraintBottom_toBottomOf="@id/videoView_preview"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/rv_item_scroll_tvchannel" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/hudcontainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.4"
        android:visibility="invisible"
        android:layout_margin="3dp"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fullscreen_channelchange"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.40"
        tools:listitem="@layout/rv_item_tvchannels"/>

</androidx.constraintlayout.widget.ConstraintLayout>