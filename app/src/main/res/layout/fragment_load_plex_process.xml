<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/background_border_settings_left"
    android:background="?attr/backgroundLight">

    <TextView
        android:id="@+id/tv_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Get and parse data!"
        android:textColor="?attr/textColorLight"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ProgressBar
        android:id="@+id/loadingBalken"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="15dp"
        android:indeterminate="true"
        app:layout_constraintTop_toBottomOf="@id/tv_info"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:indeterminateTint="@color/light_blue"
        android:visibility="invisible"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"/>

   <com.rubensousa.dpadrecyclerview.DpadRecyclerView
       android:id="@+id/rv_layout_PlexServers"
       android:layout_width="match_parent"
       android:layout_height="0dp"
       tools:listitem="@layout/rv_item_plexserver"
       app:layout_constraintTop_toBottomOf="@id/loadingBalken"
       android:layout_marginTop="15dp"
       android:padding="15dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>