<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/settings_item_background"
    android:focusableInTouchMode="true"
    android:focusable="true"
    android:id="@+id/relLayout_playlistepg"
    android:padding="5dp"
    android:elevation="1dp">

    <LinearLayout
        android:id="@+id/rv_linear_PlaylistEpg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_margin="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <CheckBox
            android:id="@+id/cb_epgSource"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="10dp"
            android:buttonTint="@color/selector_checkbox_add_channels"
            tools:ignore="TouchTargetSizeCheck"
            android:layout_gravity="center"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/rv_item_epgsources_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:textColor="?attr/textMainColor"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="DE: Sky Cinema" />

            <TextView
                android:id="@+id/rv_item_epgsources_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:textColor="@drawable/focused_selected_textview_info"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="DE: Sky Cinema" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>