<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/motionLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layoutDescription="@xml/fragment_tv_scene"
    tools:showPaths="true">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_accountwithcategories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_border_test_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_playerwithshowdetails"
        android:layout_width="0dp"
        android:layout_height="0dp" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_epggrid"
        android:layout_width="0dp"
        android:layout_height="0dp" />

</androidx.constraintlayout.motion.widget.MotionLayout>