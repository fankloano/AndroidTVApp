<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_accountwithcategories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/background_border_test_right"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_playerwithshowdetails"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/container_accountwithcategories"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.34"
        app:layout_constraintWidth_percent="1"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_epggrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toEndOf="@id/container_accountwithcategories"
        app:layout_constraintTop_toBottomOf="@id/container_playerwithshowdetails"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="1"/>

</androidx.constraintlayout.widget.ConstraintLayout>