<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:foreground="@drawable/background_border_settings_left"
    android:background="?attr/backgroundDarkDark"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_modify_epgsource"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:textSize="15sp"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="?attr/backgroundDarkDark"
        android:textColor="?attr/textColorLight"
        android:text="@string/modify_epg_source_name"/>

    <TextView
        android:id="@+id/tv_currentEpgSource"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/current_epg_source_name"
        android:textColor="?attr/textMainColor"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_below="@id/tv_modify_epgsource"/>

    <TextView
        android:id="@+id/tv_currentEpgSourceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/textColorMidLight"
        android:layout_marginTop="4dp"
        android:textColorHint="?attr/textColorDarkGrey"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        tools:ignore="TextFields"
        tools:text="http://example.com:8080"
        android:textSize="13sp"
        android:backgroundTint="@color/light_blue"
        android:layout_below="@id/tv_currentEpgSource"/>

    <TextView
        android:id="@+id/tv_changeto"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Change to:"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:layout_marginTop="20dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_below="@id/tv_currentEpgSourceName"/>

    <EditText
        android:id="@+id/et_editedChannelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_changeto"
        android:layout_marginStart="17dp"
        android:layout_marginEnd="17dp"
        android:backgroundTint="@color/light_blue"
        android:imeOptions="actionDone"
        android:textSize="13sp"
        android:nextFocusLeft="@id/et_editedChannelName"
        android:nextFocusRight="@id/et_editedChannelName"
        android:nextFocusUp="@id/et_editedChannelName"
        android:nextFocusDown="@id/relLayout_save"
        android:singleLine="true"
        android:textColor="?attr/textColorLight"
        android:textColorHint="?attr/textColorDarkGrey"
        tools:ignore="TextFields" />

    <TextView
            android:id="@+id/btn_EpgSourceSave"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="8dp"
            android:text="@string/save"
            android:gravity="center"
            android:textSize="16sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@drawable/focused_selected_textview"
            android:background="@drawable/settings_item_background"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:focusable="true"
            android:layout_centerHorizontal="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/btn_EpgSourceSave"
            android:nextFocusRight="@id/btn_EpgSourceSave"
            android:nextFocusUp="@id/et_editedChannelName"
            android:nextFocusDown="@id/btn_EpgSourceSave"
            android:layout_below="@id/et_editedChannelName"/>

</RelativeLayout>
