<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/background_border_settings_left"
    android:background="?attr/backgroundDarkDark">

    <TextView
        android:id="@+id/title_setting"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="?attr/backgroundDarkDark"
        android:gravity="start|center_vertical"
        android:text="Tv Categories"
        android:textColor="?attr/mainPrimaryColor"
        android:textSize="15sp"
        android:paddingStart="25dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/btn_selectAll"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:background="@drawable/selector_button_background"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:nextFocusLeft="@id/btn_deselectAll"
        android:nextFocusRight="@id/btn_selectAll"
        android:nextFocusUp="@id/btn_selectAll"
        android:nextFocusDown="@id/rv_layout_TvCategory"
        android:text="Select All"
        android:textColor="@drawable/focused_selected_mainmenu"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/btn_deselectAll"
        app:layout_constraintTop_toBottomOf="@id/title_setting"
        app:layout_constraintWidth_percent="0.45" />

    <TextView
        android:id="@+id/btn_deselectAll"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:layout_marginTop="5dp"
        android:nextFocusLeft="@id/btn_deselectAll"
        android:nextFocusRight="@id/btn_selectAll"
        android:nextFocusUp="@id/btn_deselectAll"
        android:nextFocusDown="@id/rv_layout_TvCategory"
        android:text="Deselect All"
        android:background="@drawable/selector_button_background"
        android:textColor="@drawable/focused_selected_mainmenu"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/btn_selectAll"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_setting"
        app:layout_constraintWidth_percent="0.45" />


    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/rv_layout_TvCategory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_selectAll"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>