<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linLayout_updatePlaylistProcess"
    android:layout_width="match_parent"
    android:layout_height="22dp"
    android:gravity="center_vertical"
    android:background="#9A000000"
    android:orientation="horizontal">


    <ImageView
        android:id="@+id/iv_pl_update_icon"
        android:layout_width="10dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:src="@drawable/selector_playlistupdate"/>

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        tools:text="UPDATE"
        android:gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/tv_currentAccount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:text="hd-max.org:8080"
        android:textSize="12sp"
        android:maxLines="1"
        android:gravity="center_horizontal"
        android:textColor="?attr/textColorMidLight"
        android:ellipsize="marquee"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"/>

</LinearLayout>