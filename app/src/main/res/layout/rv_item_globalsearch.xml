<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/recycler_playlists"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.10"
        tools:listitem="@layout/rv_item_globalsearch_playlist"
        android:orientation="horizontal" />

    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/recycler_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/recycler_playlists"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:listitem="@layout/rv_item_fullepg"
        android:orientation="vertical"
        app:spanCount="7"
        app:dpadRecyclerViewChildAlignmentFraction="0"
        app:dpadRecyclerViewParentAlignmentFraction="0"
        app:dpadRecyclerViewParentAlignmentEdge="none"/>

</androidx.constraintlayout.widget.ConstraintLayout>