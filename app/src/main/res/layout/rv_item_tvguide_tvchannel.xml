<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/relLayout_scroll_tvchannel"
    android:layout_width="200dp"
    android:layout_height="50dp"
    android:gravity="center_vertical"
    android:focusable="true"
    android:background="@drawable/selector_scroll_tvchannel_background"
    android:focusableInTouchMode="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <com.google.android.material.imageview.ShapeableImageView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:id="@+id/iv_channel_logo"
        app:layout_constraintWidth_percent="0.3"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="3dp"
        android:layout_marginStart="5dp"
        android:paddingStart="2dp"
        app:shapeAppearanceOverlay="@style/roundedImageViewBottomUpLeft"
        tools:src="@drawable/skybundesliga"
        android:duplicateParentState="true"
        android:scaleType="centerInside"/>

    <TextView
        android:id="@+id/tv_channelname"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="DE: SKY CINEMA HIGHLIGHT 4K FHD"
        android:textColor="@drawable/selector_textview_scroll_tvchannels"
        android:textSize="13sp"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:scrollHorizontally="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintStart_toEndOf="@id/iv_channel_logo"/>

    <ImageView
        android:id="@+id/iv_favorite"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="5dp"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_favorite"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/iv_catchup"
        android:layout_width="15dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_catchup"
        android:layout_marginEnd="5dp"
        android:layout_marginTop="1dp"
        app:layout_constraintEnd_toStartOf="@id/iv_favorite"
        app:layout_constraintTop_toTopOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>