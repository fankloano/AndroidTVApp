<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:id="@+id/rv_item_epgsource"
    android:background="?attr/backgroundMain"
    android:descendantFocusability="afterDescendants"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/rv_linear_EpgSource"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_margin="1dp"
        android:padding="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@drawable/settings_item_background_darklight">

        <TextView
            android:id="@+id/text_epgsource_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textColor="@drawable/focused_selected_mainmenu"
            android:textSize="13sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            tools:text="DE: Sky Cinema"
            android:singleLine="true"
            android:gravity="center_vertical"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>