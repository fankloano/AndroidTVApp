<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_height="wrap_content"
    android:layout_width="400dp"
    android:padding="10dp"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/backgroundDarkDark"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="80dp">

        <ImageView
            android:id="@+id/itemLogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent="0.2"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="5dp"
            app:layout_constraintStart_toEndOf="@id/relLayout_itemName"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="?attr/backgroundDarkDark"
            tools:src="@drawable/skybundesliga"
            android:textColor="?attr/textMainColor"
            android:maxLines="1"
            android:ellipsize="marquee"
            android:scrollHorizontally="true"
            android:textSize="16sp"
            android:scaleType="centerInside" />

        <RelativeLayout
            android:id="@+id/relLayout_itemName"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.75">

            <TextView
                android:id="@+id/itemName"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:background="?attr/backgroundDarkDark"
                tools:text="DE | SKY CINEMA HIGHLIGHTS $K fhd"
                android:textColor="?attr/textMainColor"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:scrollHorizontally="true"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/programName"
                android:layout_width="match_parent"
                android:layout_height="25dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_below="@id/itemName"
                android:background="?attr/backgroundDarkDark"
                tools:text="DE | DER HERR DER RINGE - DIE ZWEI TÜRME"
                android:maxLines="1"
                android:textColor="?attr/textColorLight"
                android:ellipsize="marquee"
                android:scrollHorizontally="true"
                android:textSize="15sp"
                android:clickable="true" />

        </RelativeLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/optionRemove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Play program"
        android:background="@drawable/selector_popup_options"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@id/optionRemove"
        android:textSize="15sp"
        android:clickable="true" />

    <TextView
        android:id="@+id/optionReplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Replay from beginning"
        android:background="@drawable/selector_popup_options"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:textSize="15sp"
        android:clickable="true" />


    <TextView
        android:id="@+id/optionFullWatched"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="@string/set_movie_as_completely_watched"
        android:background="@drawable/selector_popup_options"
        android:textSize="15sp"
        android:focusable="true"
        android:focusableInTouchMode="true" />
    </LinearLayout>
