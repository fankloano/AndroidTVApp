<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardView_tvchannel"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:padding="5dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:background="@drawable/selector_card_tvchannel"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <CheckBox
            android:id="@+id/cb_tvChannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:translationX="-5dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:buttonTint="?attr/mainPrimaryColor"
            tools:ignore="TouchTargetSizeCheck" />


        <ImageView
                android:id="@+id/iv_channellogo_image"
                android:layout_width="49dp"
                android:layout_height="80dp"
                app:layout_constraintWidth_percent="0.12"
                android:scaleType="fitCenter"
                android:layout_marginStart="2dp"
                android:src="@drawable/skybundesliga"
                app:layout_constraintStart_toEndOf="@id/iv_catchup"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/iv_new"
            android:layout_width="25dp"
            android:layout_height="15dp"
            android:layout_margin="1dp"
            android:background="?attr/mainPrimaryColor"
            android:gravity="center"
            android:padding="1dp"
            android:text="NEW"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/iv_favorite"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_favorite"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tv_tvchannelname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="DE | SKY BUNDESLIGA 1 FHD"
            app:layout_constraintStart_toEndOf="@id/iv_channellogo_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/order_channel_selected"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="5dp"
            android:textSize="15sp"
            android:textColor="@drawable/selector_channel_name"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"/>

        <ImageView
            android:id="@+id/iv_catchup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_catchup"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_tvchannelname"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_channellogo_image"
            app:layout_constraintEnd_toStartOf="@id/order_channel_selected"
            android:layout_marginStart="25dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="5dp"
            android:gravity="center_vertical"
            app:layout_constraintEnd_toEndOf="parent" >

        <TextView
            android:id="@+id/tv_currentStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:20"
            android:textColor="#94D1CFCF"
            android:textSize="12sp"
            android:layout_marginTop="1dp"
            android:fontFamily="sans-serif-smallcaps"
            android:typeface="monospace"/>

        <TextView
            android:id="@+id/tv_currentEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - 08:20"
            android:textColor="#94D1CFCF"
            android:textSize="12sp"
            android:layout_marginTop="1dp"
            android:layout_toEndOf="@id/tv_currentStartTime"
            android:fontFamily="sans-serif-smallcaps"
            android:typeface="monospace"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constLayout_currentprogramm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_currentStartTime">

                <TextView
                    android:id="@+id/tv_currentProgram"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    tools:text="Es war einmal in Amerika..Es war einmal in Amerika.."
                    android:layout_marginEnd="20dp"
                    android:textSize="14sp"
                    android:textColor="?attr/textColorLight"
                    android:singleLine="true"
                    android:ellipsize="marquee"
                    android:scrollHorizontally="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/iv_reminder"/>

                    <ImageView
                        android:id="@+id/iv_reminder"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_alarm"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="3dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@id/constLayout_currentprogramm">

        <TextView
            android:id="@+id/tv_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next"
            android:textColor="#94D1CFCF"
            android:layout_marginEnd="5dp"
            android:layout_gravity="bottom"
            android:textSize="12sp"
            android:typeface="monospace"/>

        <TextView
            android:id="@+id/tv_nextProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Es war einmal in Amerika..asdasdasd"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="2dp"
            android:layout_gravity="bottom"
            android:textSize="13sp"
            android:textColor="?attr/textColorMidLight"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"/>


    </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:padding="1dp"
                android:progress="20"
                android:progressTint="?attr/mainPrimaryColor"
                android:layout_marginBottom="1dp"
                android:layout_alignParentBottom="true"/>

        </RelativeLayout>

        <ImageView
            android:id="@+id/order_channel_selected"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_channel_selected"
            android:adjustViewBounds="false"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    <View
        android:id="@+id/border_animated_orderchannel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:background="@drawable/background_border_maincolor_rounded"/>

    <View
        android:id="@+id/border_orderselectchannel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:background="@drawable/background_border_white_rounded"/>

    <View
        android:id="@+id/border_assignepgtoChannel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:background="@drawable/background_border_white_rounded"/>

</androidx.constraintlayout.widget.ConstraintLayout>