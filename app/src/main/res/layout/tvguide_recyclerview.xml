<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/backgroundDarkDark"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.mj_player_tv.utils.views.RecyclerWithPositionView
        android:id="@+id/rv_channels_logos"
        android:layout_width="180dp"
        android:layout_height="0dp"
        android:background="?attr/backgroundDark"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:nextFocusRight="@id/rv_channellogos"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rv_channellogos" />

    <com.example.mj_player_tv.utils.views.RecyclerWithPositionView
        android:id="@+id/rv_time_line"
        android:layout_width="0dp"
        android:layout_height="34dp"
        android:background="?attr/backgroundDarkDark"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/rv_channels_logos"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/rv_item_tvguide_timeline" />

    <com.example.mj_player_tv.utils.views.RecyclerWithPositionView
        android:id="@+id/rv_channellogos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:background="?attr/backgroundDark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/rv_time_line"
        app:layout_constraintTop_toBottomOf="@id/rv_time_line" />

    <View
        android:layout_width="15dp"
        android:layout_height="0dp"
        android:foreground="@drawable/gradient_overlay_fromleft"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/rv_time_line"
        app:layout_constraintTop_toBottomOf="@id/rv_time_line"/>

    <View
        android:id="@+id/time_indicator"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/light_grey"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/rv_channels_logos"
        app:layout_constraintTop_toBottomOf="@id/rv_time_line"
        tools:layout_marginStart="200dp" />

    <View
        android:id="@+id/time_indicator_bubble"
        android:layout_width="4dp"
        android:layout_height="3dp"
        android:background="@color/light_grey"
        app:layout_constraintStart_toStartOf="@id/time_indicator"
        app:layout_constraintEnd_toEndOf="@id/time_indicator"
        app:layout_constraintBottom_toBottomOf="@id/rv_time_line"/>


    <TextView
        android:id="@+id/tv_time_line_label"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:background="@drawable/background_tvguide_tvchannel_default"
        android:gravity="center"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/rv_time_line"
        tools:text="12:12"
        android:textSize="13sp"/>

</androidx.constraintlayout.widget.ConstraintLayout>