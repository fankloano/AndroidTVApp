<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="20dp"
    android:background="?attr/backgroundLight"
    android:foreground="@drawable/background_border_settings_left">



    <TextView
        android:id="@+id/tv_epgsourceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/epg_source_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:textColor="?attr/textMainColor"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"/>

    <EditText
        android:id="@+id/et_epgsourceName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:hint="@string/recommended"
        android:backgroundTint="@color/light_blue"
        android:ems="10"
        android:textSize="14sp"
        android:inputType="textPersonName"
        android:minHeight="28dp"
        android:layout_marginStart="15dp"
        android:textColor="@color/light_blue"
        android:textColorHint="#99FFFFFF"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusDown="@id/et_epgUrl"
        android:nextFocusLeft="@id/et_epgsourceName"
        android:nextFocusRight="@id/et_epgsourceName"
        android:nextFocusUp="@id/et_epgsourceName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_epgsourceName" />

    <TextView
        android:id="@+id/tv_epgUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Epg Url:"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_epgsourceName"
        android:textColor="?attr/textMainColor"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="20dp"/>

    <EditText
        android:id="@+id/et_epgUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="10dp"
        android:backgroundTint="@color/light_blue"
        android:ems="10"
        android:hint="Use .xml, .gz or.xz format"
        android:inputType="textUri"
        android:minHeight="28dp"
        android:textSize="14sp"
        android:layout_marginStart="15dp"
        android:textColor="@color/light_blue"
        android:textColorHint="#99FFFFFF"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@id/et_epgsourceName"
        android:nextFocusDown="@id/btn_saveEpg"
        android:nextFocusRight="@id/et_epgUrl"
        android:nextFocusLeft="@id/et_epgUrl"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_epgUrl" />

    <Button
        android:id="@+id/btn_saveEpg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="8dp"
        android:text="@string/save"
        android:textSize="16sp"
        android:textColor="@drawable/focused_selected_textview"
        android:background="@drawable/selector_button_background"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusLeft="@id/btn_saveEpg"
        android:nextFocusRight="@id/btn_saveEpg"
        android:nextFocusUp="@id/et_epgUrl"
        android:nextFocusDown="@id/btn_saveEpg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_epgUrl" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_saveEpg">

    <LinearLayout
        android:id="@+id/linLayout_downloadEpg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">


            <TextView
                android:id="@+id/tv_epgDownload"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:text="Download successfull!"
                android:textColor="?attr/textColorLight"
                android:textSize="14sp"
                android:gravity="center|center_vertical"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>

    </LinearLayout>

       <LinearLayout
        android:id="@+id/linLayout_insertdatabase"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/linLayout_downloadEpg">

        <TextView
            android:id="@+id/tv_epgchannels"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="EPGCHANNELS: 100"
            android:layout_gravity="center_vertical"/>

           <TextView
               android:id="@+id/tv_programs"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               tools:text="PROGRAMS: 100"
               android:layout_marginStart="20dp"
               android:layout_gravity="center_vertical"/>

    </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>