<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/selector_card_prior_epgsource"
    android:focusableInTouchMode="true"
    android:focusable="true"
    android:id="@+id/relLayout_playlistepg"
    android:padding="5dp"
    android:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="1dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/rv_item_epgsources_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="?attr/textMainColor"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="DE: Sky Cinema" />

            <TextView
                android:id="@+id/rv_item_epgsources_url"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="?attr/textColorLight"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="DE: Sky Cinema" />

        </LinearLayout>

</RelativeLayout>