<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="45dp"
    android:layout_marginBottom="5dp"
    android:layout_marginTop="5dp"
    android:id="@+id/rv_item_searchhistory"
    android:background="?attr/backgroundDarkDark"
    android:descendantFocusability="afterDescendants"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/rv_linear_SearchHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_margin="1dp"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@drawable/background_globalsearch_historyitem">

        <TextView
            android:id="@+id/tv_searchterm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textColor="@drawable/selector_textview_globalsearch_history"
            android:textSize="17sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            tools:text="Scrubsgggg"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>