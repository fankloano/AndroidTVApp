<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?attr/backgroundDark">

    <!-- Channel Bereich links -->
    <LinearLayout
        android:id="@+id/llChannelInfo"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:weightSum="1"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.2">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivChannelLogo"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.3"
            android:scaleType="centerInside"
            android:paddingStart="2dp"
            android:layout_marginStart="5dp"
            app:shapeAppearanceOverlay="@style/roundedImageViewBottomUpLeft"
            tools:src="@drawable/skybundesliga" />

        <TextView
            android:id="@+id/tvChannelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.65"
            android:textColor="?attr/textMainColor"
            android:textSize="13sp"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:layout_marginStart="5dp"
            android:scrollHorizontally="true"
            android:marqueeRepeatLimit="marquee_forever"
            tools:text="DE: SKY CINEMA HIGHLIGHT 4K FHD" />

    </LinearLayout>

    <!-- EPG Programme horizontal, von LayoutManager gesteuert -->
    <FrameLayout
        android:id="@+id/flProgramsContainer"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toEndOf="@id/llChannelInfo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Programme werden dynamisch vom CustomLayoutManager gezeichnet -->
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
