<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:foreground="@drawable/background_border_settings_left"
    android:background="?attr/backgroundLight"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/manage_playlist"
        android:textSize="20sp"
        android:textColor="?attr/textColorLight"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:background="?attr/backgroundDark"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

 <com.google.android.material.tabs.TabLayout
     android:id="@+id/tab_layout"
     android:layout_width="match_parent"
     android:layout_height="50dp"
     android:background="?attr/backgroundSettings"
     android:elevation="2dp"
     app:layout_constraintStart_toStartOf="parent"
     app:layout_constraintEnd_toEndOf="parent"
     app:layout_constraintTop_toBottomOf="@id/tv_title"
     app:tabIndicatorColor="@color/light_blue"
     app:tabSelectedTextColor="@color/light_blue"
     app:tabTextColor="?attr/textMainColor"
     app:tabMode="scrollable"
     android:focusableInTouchMode="true"
     android:focusable="true"/>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_manage_playlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_layout"/>
    
</androidx.constraintlayout.widget.ConstraintLayout>