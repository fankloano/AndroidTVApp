<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constrChannels"
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:background="@color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardView_tvchannel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.87"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@drawable/selector_fullscreen_changechannel"
        android:layout_margin="2dp">

            <ImageView
                android:id="@+id/iv_channellogo_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="0.12"
                android:scaleType="fitCenter"
                android:layout_marginStart="15dp"
                tools:src="@drawable/skybundesliga"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/const_currentchannel_info"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:alpha="0.7"
            app:layout_constraintStart_toEndOf="@id/iv_channellogo_image"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="20dp">

            <TextView
                android:id="@+id/tv_tvchannelname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="DE | SKY BUNDESLIGA 1 FHD"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginEnd="5dp"
                android:textSize="13sp"
                android:textColor="@drawable/selector_channel_name"
                android:singleLine="true"
                android:scrollHorizontally="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"/>

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/tv_tvchannelname"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="5dp"
            app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_currentStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="08:20"
            android:textColor="?attr/textColorLight"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tv_currentEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" - 08:20"
            android:textColor="?attr/textColorLight"
            android:textSize="12sp"
            android:layout_toEndOf="@id/tv_currentStartTime"/>

        <TextView
            android:id="@+id/tv_currentProgram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Es war einmal in Amerika.."
            android:layout_marginEnd="5dp"
            android:layout_below="@id/tv_currentStartTime"
            android:textSize="13sp"
            android:textColor="?attr/textMainColor"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"/>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:padding="1dp"
                android:progress="20"
                android:progressTint="?attr/mainPrimaryColor"
                android:layout_marginBottom="3dp"
                android:layout_alignParentBottom="true"/>

        </RelativeLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>