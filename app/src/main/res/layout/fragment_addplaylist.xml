<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundDarkDark"
    android:foreground="@drawable/background_border_settings_left"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provider_type"
            android:textSize="16sp"
            android:textColor="?attr/mainPrimaryColor"
            android:paddingStart="32dp"
            android:paddingEnd="30dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp"
            android:background="?attr/backgroundDarkDark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>


        <TextView
            android:id="@+id/btn_addXtream"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:textSize="15sp"
            android:background="@drawable/settings_item_background"
            android:focusable="true"
            android:gravity="center_vertical"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:nextFocusDown="@id/btn_addStalker"
            android:nextFocusUp="@id/btn_addplex"
            android:nextFocusLeft="@id/btn_addXtream"
            android:text="+   Xtream Codes"
            android:textColor="@drawable/focused_selected_mainmenu" />

        <TextView
            android:id="@+id/btn_addStalker"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="5dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:textSize="15sp"
            android:background="@drawable/settings_item_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:nextFocusUp="@id/btn_addXtream"
            android:nextFocusDown="@id/btn_addplex"
            android:nextFocusLeft="@id/btn_addStalker"
            android:gravity="center_vertical"
            android:text="+   Stalker Portal"
            android:textColor="@drawable/focused_selected_mainmenu" />


        <TextView
            android:id="@+id/btn_addplex"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="5dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="5dp"
            android:textSize="15sp"
            android:gravity="center_vertical"
            android:background="@drawable/settings_item_background"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:nextFocusUp="@id/btn_addStalker"
            android:nextFocusDown="@id/btn_addXtream"
            android:nextFocusLeft="@id/btn_addplex"
            android:text="+   Plex Account"
            android:textColor="@drawable/focused_selected_mainmenu" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>