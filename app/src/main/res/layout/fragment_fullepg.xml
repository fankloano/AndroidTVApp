<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/transparentColor"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/channel_info"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:background="?attr/backgroundDark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.52"
        app:layout_constraintTop_toTopOf="parent">

    <ImageView
        android:id="@+id/iv_channellogo_image"
        android:layout_width="60dp"
        android:layout_height="25dp"
        android:layout_centerVertical="true"
        app:layout_constraintWidth_percent="0.12"
        android:scaleType="fitCenter"
        android:layout_marginStart="15dp"
        android:src="@drawable/skybundesliga" />

        <TextView
            android:id="@+id/tv_tvchannelname"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            tools:text="DE | SKY BUNDESLIGA 1 FHD"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="40dp"
            android:gravity="center_vertical"
            android:textSize="15sp"
            android:layout_toEndOf="@id/iv_channellogo_image"
            android:textColor="?attr/textColorLight"
            android:fontFamily="sans-serif-smallcaps"
            android:typeface="monospace"/>

        <ImageView
            android:id="@+id/iv_catchup"
            android:layout_width="40dp"
            android:layout_height="15dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/ic_catchup"
            android:tint="?attr/textColorLight"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="15dp"
            android:layout_alignParentEnd="true"/>

        <TextView
            android:id="@+id/tv_archiveTime"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            tools:text="36h"
            android:gravity="center_horizontal"
            android:layout_marginEnd="15dp"
            android:textSize="10sp"
            android:layout_marginBottom="5dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:textColor="?attr/textColorLight" />

</RelativeLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/light_blue"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="@id/channel_info"
        app:layout_constraintTop_toBottomOf="@id/channel_info"/>


    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/tablayout_epg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:background="?attr/backgroundDark"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.11"
        android:nextFocusRight="@id/rv_fullepg"
        android:orientation="vertical"
        android:gravity="center_vertical|center_horizontal"
        tools:listitem="@layout/rv_item_fullepg_tabs"/>


    <RelativeLayout
        android:id="@+id/relLayout_fullEpg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/backgroundDark"
        app:layout_constraintStart_toEndOf="@id/tablayout_epg"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.41">
    
    <com.rubensousa.dpadrecyclerview.DpadRecyclerView
        android:id="@+id/rv_fullepg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="5dp"
        android:layout_marginEnd="5dp"
        android:nextFocusLeft="@id/tablayout_epg"
        android:background="?attr/backgroundDark"
        tools:listitem="@layout/rv_item_fullepg"/>

        <ProgressBar
            android:id="@+id/loadepg_progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:backgroundTint="?attr/mainPrimaryColor"
            android:visibility="invisible"/>

        <TextView
            android:id="@+id/tv_noepgdata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_epg_available"
            android:layout_centerInParent="true"
            android:textSize="13sp"
            android:textColor="?attr/textColorLight"
            android:visibility="invisible"/>

    </RelativeLayout>

    <View
        android:id="@+id/overlay_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#BA000000"
        android:visibility="gone"
        android:layout_marginTop="5dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RelativeLayout
        android:id="@+id/menu_EpgOptions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:visibility="gone"
        app:layout_constraintWidth_percent="0.20"
        app:layout_constraintHeight_percent="0.50"
        app:layout_constraintEnd_toStartOf="@id/relLayout_detailEpg"
        android:background="@drawable/background_fullepg_options"
        app:layout_constraintBottom_toBottomOf="parent">


                <TextView
                    android:id="@+id/play_program"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentStart="true"
                    tools:text="Play Program"
                    android:padding="14dp"
                    android:textSize="13sp"
                    android:focusable="true"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginStart="1.5dp"
                    android:focusableInTouchMode="true"
                    android:nextFocusRight="@id/play_program"
                    android:nextFocusLeft="@id/play_program"
                    android:nextFocusUp="@id/play_program"
                    android:nextFocusDown="@id/replay_program"
                    android:background="@drawable/selector_fullepg_epgoptions_tv"
                    android:textColor="@drawable/selector_textview_fullepgoptions"
                    />

                <TextView
                    android:id="@+id/replay_program"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Play Program"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="14dp"
                    android:textSize="13sp"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginStart="1.5dp"
                    android:layout_below="@id/play_program"
                    android:nextFocusRight="@id/replay_program"
                    android:nextFocusLeft="@id/replay_program"
                    android:nextFocusUp="@id/play_program"
                    android:nextFocusDown="@id/remind_program"
                    android:background="@drawable/selector_fullepg_epgoptions_tv"
                    android:textColor="@drawable/selector_textview_fullepgoptions"/>

                <TextView
                    android:id="@+id/remind_program"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Remind Program"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="14dp"
                    android:textSize="13sp"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginStart="1.5dp"
                    android:layout_below="@id/replay_program"
                    android:nextFocusUp="@id/replay_program"
                    android:nextFocusDown="@id/search_program"
                    android:nextFocusRight="@id/remind_program"
                    android:nextFocusLeft="@id/remind_program"
                    android:background="@drawable/selector_fullepg_epgoptions_tv"
                    android:textColor="@drawable/selector_textview_fullepgoptions"/>

                <TextView
                    android:id="@+id/search_program"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Search for program"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="14dp"
                    android:textSize="13sp"
                    android:layout_marginTop="1.5dp"
                    android:layout_marginStart="1.5dp"
                    android:layout_below="@id/remind_program"
                    android:nextFocusUp="@id/remind_program"
                    android:nextFocusRight="@id/search_program"
                    android:nextFocusLeft="@id/search_program"
                    android:nextFocusDown="@id/search_program"
                    android:background="@drawable/selector_fullepg_epgoptions_tv"
                    android:textColor="@drawable/selector_textview_fullepgoptions"
                    android:layout_marginBottom="10dp"/>

        </RelativeLayout>

    <RelativeLayout
        android:id="@+id/relLayout_detailEpg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="5dp"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintStart_toEndOf="@id/relLayout_fullEpg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.52">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_rounded_rightup_rightdown_gradient_fullepg_detailepg"
        android:id="@+id/detailepgcontainerview"
        android:padding="5dp">

        <TextView
            android:id="@+id/tv_currentStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="08:20"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:textColor="#CBFFFFFF"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tv_currentEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="2dp"
            tools:text=" - 08:20"
            android:textColor="#CBFFFFFF"
            android:textSize="12sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/tv_currentStartTime"/>

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="80dp"
            android:layout_height="5dp"
            android:padding="1dp"
            android:progress="20"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tv_currentEndTime"
            android:layout_marginTop="10dp"
            app:layout_constraintStart_toEndOf="@id/tv_currentEndTime"
            android:layout_marginStart="15dp"
            android:progressTint="?attr/mainPrimaryColor"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/tv_remainingTimeCurrentProgram"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/progressBar"
            tools:text="1h 25min"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:textSize="12sp"
            android:textColor="?attr/textColorMidLight"/>

        <TextView
            android:id="@+id/tv_currentProgram"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="6dp"
            tools:text="Es war einmal in Amerika"
            android:textColor="?attr/textMainColor"
            android:textSize="15sp"
            android:scrollHorizontally="true"
            android:ellipsize="marquee"
            android:maxLines="1"
            android:marqueeRepeatLimit="marquee_forever"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_currentStartTime"/>

        <RelativeLayout
            android:id="@+id/relLayout_mainInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_currentProgram">

            <TextView
                android:id="@+id/tv_currentSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="10dp"
                android:scrollHorizontally="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                tools:text="Folge 5, Staffel 10 - Es war einmal ein Mann"
                android:textColor="?attr/textColorLight"
                android:textSize="13sp"
                android:textStyle="" />

            <TextView
                android:id="@+id/tv_currentCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="2dp"
                tools:text="Action, Abenteuer"
                android:textColor="?attr/textColorLight"
                android:textSize="13sp"
                android:textStyle=""
                android:layout_below="@id/tv_currentSubtitle"/>

            <TextView
                android:id="@+id/tv_currentCountry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text=" | DE"
                android:textColor="?attr/textColorLight"
                android:textSize="13sp"
                android:layout_marginStart="5dp"
                android:textStyle=""
                android:layout_toEndOf="@id/tv_currentCategory"
                android:layout_below="@id/tv_currentSubtitle"/>

            <TextView
                android:id="@+id/tv_currentDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="| 2017"
                android:textColor="?attr/textColorLight"
                android:textSize="13sp"
                android:layout_marginStart="5dp"
                android:textStyle=""
                android:layout_toEndOf="@id/tv_currentCountry"
                android:layout_below="@id/tv_currentSubtitle"/>

        </RelativeLayout>

        <TextView
            android:id="@+id/tv_description"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="8dp"
            android:focusableInTouchMode="true"
            android:focusable="true"
            android:scrollbars="vertical"
            android:overScrollMode="never"
            android:fadeScrollbars="false"
            android:background="?attr/backgroundDark"
            tools:text="In drei ineinander verwobenen Zeitabschnitten (1922, 1933 und 1968) wird die Geschichte einer Bande in New York City erzählt. Sie kommt während der Alkoholprohibition in den USA zu schnellem Reichtum und viel Macht, indem sie Schutzgeld erpresst, Konkurrenten gewaltsam aus dem Weg räumt und Alkohol schmuggelt.In drei ineinander verwobenen Zeitabschnitten (1922, 1933 und 1968) wird die Geschichte einer Bande in New York City erzählt. Sie kommt während der Alkoholprohibition in den USA zu schnellem Reichtum und viel Macht, indem sie Schutzgeld erpresst, Konkurrenten gewaltsam aus dem Weg räumt und Alkohol schmuggelt.In drei ineinander verwobenen Zeitabschnitten (1922, 1933 und 1968) wird die Geschichte einer Bande in New York City erzählt. Sie kommt während der Alkoholprohibition in den USA zu schnellem Reichtum und viel Macht, indem sie Schutzgeld erpresst, Konkurrenten gewaltsam aus dem Weg räumt und Alkohol schmuggelt."
            android:textColor="?attr/textColorLight"
            android:textSize="13sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/relLayout_mainInfo" />

        <View
            android:id="@+id/gradientView"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/gradient_overlay_description"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_description"
            app:layout_constraintEnd_toEndOf="@id/tv_description" />

        <View
            android:id="@+id/descriptionborder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="1dp"
            android:layout_marginEnd="1dp"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:layout_marginTop="1dp"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            android:background="@drawable/background_border_grey_rounded"
            app:layout_constraintBottom_toBottomOf="@id/tv_description"
            app:layout_constraintTop_toTopOf="@id/tv_description"
            app:layout_constraintStart_toStartOf="@id/tv_description"
            app:layout_constraintEnd_toEndOf="@id/tv_description" />


        <ImageView
            android:id="@+id/iv_moretext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-10dp"
            android:visibility="gone"
            android:src="@drawable/ic_arrow_down"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_description"
            app:layout_constraintEnd_toEndOf="@id/tv_description"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>